{"version":"2.0","class":"dataset","label":"03174: Eksisterende bygningsmasse. Fritidsbygg, etter region, statistikkvariabel og år","source":"Statistisk sentralbyrå","updated":"2026-02-04T07:00:00Z","note":["Bygninger med flere boenheter regnes som en bygning","Fra og med 01.01.2022 inkluderer bygningsmassen ferdigstilte bygg som er fritatt byggesaksbehandling, men som likevel er meldepliktige og registreres i Matrikkelen. Dette gjelder bygg med bygningsstatusene IP = 'Tiltak unntatt fra byggesaksbehandling' og FS = 'Fritatt for Søknadsplikt'. Per 01.01.2022 er det registrert 21 281 bygg med 'IP' eller 'FS' i matrikkelen. Av disse er 92% garasjer/uthus/anneks til boliger eller fritidsboliger.","[Se liste over endringer i de regionale inndelingene](https://www.ssb.no/offentlig-sektor/kommunekatalog/endringer-i-de-regionale-inndelingene)."],"role":{"time":["Tid"],"geo":["Region"],"metric":["ContentsCode"]},"id":["Region","ContentsCode","Tid"],"size":[9,1,1],"dimension":{"Region":{"label":"region","category":{"index":{"31":0,"3101":1,"3103":2,"3105":3,"3107":4,"3110":5,"3118":6,"3120":7,"3124":8},"label":{"31":"Østfold","3101":"Halden","3103":"Moss","3105":"Sarpsborg","3107":"Fredrikstad","3110":"Hvaler","3118":"Indre Østfold","3120":"Rakkestad","3124":"Aremark"}},"extension":{"elimination":false,"show":"code_value"},"link":{"describedby":[{"extension":{"Region":"urn:ssb:classification:klass:104 urn:ssb:classification:klass:131"}}]}},"ContentsCode":{"label":"statistikkvariabel","category":{"index":{"Fritidshus":0},"label":{"Fritidshus":"Eksisterende bygninger"},"unit":{"Fritidshus":{"base":"bygninger","decimals":0}}},"extension":{"elimination":false,"refperiod":{"Fritidshus":"01.01."},"show":"value","measuringType":{"Fritidshus":"Stock"},"priceType":{"Fritidshus":"NotApplicable"},"adjustment":{"Fritidshus":"None"}}},"Tid":{"label":"år","category":{"index":{"2026":0},"label":{"2026":"2026"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"px":{"infofile"